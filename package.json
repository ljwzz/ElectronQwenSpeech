{
  "name": "electron-qwen-speech",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=11.5.2 <12"
  },
  "scripts": {
    "dev": "node scripts/runWithLocalEnv.mjs corepack pnpm --filter @electron-qwen-speech/desktop start",
    "start": "corepack pnpm run dev",
    "clean": "rimraf apps/desktop/.vite apps/desktop/renderer/.vite apps/desktop/out",
    "lint": "eslint . && stylelint 'apps/desktop/renderer/src/**/*.{css,vue}'",
    "lint:fix": "eslint . --fix && stylelint 'apps/desktop/renderer/src/**/*.{css,vue}' --fix",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test",
    "test:scripts": "node --test scripts/runWithLocalEnv.test.mjs && services/asr-sidecar/.venv-mlx/bin/python -m unittest scripts.test_validate_mlx_speech_models scripts.test_benchmark_speech_runtime",
    "test:asr:real": "node scripts/runWithLocalEnv.mjs corepack pnpm --filter @electron-qwen-speech/desktop run test:asr:real",
    "test:tts:real": "node scripts/runWithLocalEnv.mjs corepack pnpm --filter @electron-qwen-speech/desktop run test:tts:real",
    "test:speech:real": "node scripts/runWithLocalEnv.mjs corepack pnpm --filter @electron-qwen-speech/desktop run test:speech:real",
    "validate:speech-models:mlx": "node scripts/runWithLocalEnv.mjs services/asr-sidecar/.venv-mlx/bin/python scripts/validate_mlx_speech_models.py",
    "benchmark:tts:mlx": "node scripts/runWithLocalEnv.mjs services/tts-sidecar/.venv-mlx/bin/python scripts/benchmark_speech_runtime.py --capability tts",
    "benchmark:asr:mlx": "node scripts/runWithLocalEnv.mjs services/asr-sidecar/.venv-mlx/bin/python scripts/benchmark_speech_runtime.py --capability asr",
    "check": "corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run test:scripts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "postcss-html": "2.0.0",
    "rimraf": "6.1.3",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.2.0",
    "typescript": "6.0.3"
  }
}
